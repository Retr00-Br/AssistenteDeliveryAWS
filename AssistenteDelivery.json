{
  "Comment": "Assistente de Delivery inteligente usando Step Functions e Amazon Bedrock",
  "StartAt": "ValidarPedido",
  "States": {
    "ValidarPedido": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.pedidoValido",
          "BooleanEquals": true,
          "Next": "PersonalizarRecomendacaoBedrock"
        }
      ],
      "Default": "PedidoInvalido"
    },
    "PersonalizarRecomendacaoBedrock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::bedrock:invokeModel",
      "Parameters": {
        "ModelId": "anthropic.claude-3-haiku-20240307-v1:0",
        "Body": {
          "anthropic_version": "bedrock-2023-05-31",
          "max_tokens": 200,
          "messages": [
            {
              "role": "user",
              "content": "Com base no histórico do cliente em '$.cliente.historico', sugira uma mensagem amigável de acompanhamento e uma recomendação de item adicional para o pedido atual."
            }
          ]
        }
      },
      "ResultPath": "$.recomendacaoIA",
      "Next": "ProcessarPagamento"
    },
    "ProcessarPagamento": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:123456789012:function:ProcessarPagamento",
        "Payload": {
          "pedidoId.$": "$.pedidoId",
          "valor.$": "$.valorTotal"
        }
      },
      "ResultPath": "$.statusPagamento",
      "Next": "VerificarPagamento"
    },
    "VerificarPagamento": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.statusPagamento.Payload.sucesso",
          "BooleanEquals": true,
          "Next": "NotificarCozinha"
        }
      ],
      "Default": "FalhaPagamento"
    },
    "NotificarCozinha": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:123456789012:PedidosCozinhaTopic",
        "Message": {
          "pedidoId.$": "$.pedidoId",
          "itens.$": "$.itens",
          "mensagemIA.$": "$.recomendacaoIA.Body.content[0].text"
        }
      },
      "Next": "AguardarPreparo"
    },
    "AguardarPreparo": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "AtualizarStatusEntrega"
    },
    "AtualizarStatusEntrega": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "StatusPedidos",
        "Key": {
          "PedidoId": {
            "S.$": "$.pedidoId"
          }
        },
        "UpdateExpression": "SET statusPedido = :s",
        "ExpressionAttributeValues": {
          ":s": {
            "S": "SAIU_PARA_ENTREGA"
          }
        }
      },
      "Next": "SucessoEntrega"
    },
    "SucessoEntrega": {
      "Type": "Succeed"
    },
    "PedidoInvalido": {
      "Type": "Fail",
      "Cause": "Pedido contem dados invalidos ou ausentes."
    },
    "FalhaPagamento": {
      "Type": "Fail",
      "Cause": "Transacao recusada ou sem saldo."
    }
  }
}
